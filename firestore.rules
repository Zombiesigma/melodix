rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isSelf(uid) { return signedIn() && request.auth.uid == uid; }
    function isAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid))
        && get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.active == true;
    }
    function owns(resourceData) {
      return signedIn() && resourceData.ownerUid == request.auth.uid;
    }
    function ownsApprovedBand(bandId) {
      return signedIn()
        && bandId is string
        && exists(/databases/$(database)/documents/bands/$(bandId))
        && get(/databases/$(database)/documents/bands/$(bandId)).data.ownerUid == request.auth.uid
        && get(/databases/$(database)/documents/bands/$(bandId)).data.verificationStatus == 'approved';
    }
    function validUserCreate(uid) {
      return isSelf(uid)
        && request.resource.data.uid == uid
        && request.resource.data.role == 'fan'
        && request.resource.data.keys().hasOnly(['uid','email','displayName','role','createdAt','updatedAt']);
    }

    match /users/{uid} {
      allow read: if isSelf(uid) || isAdmin();
      allow create: if validUserCreate(uid) || isAdmin();
      allow update: if isAdmin() || (isSelf(uid)
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['displayName','photoURL','updatedAt']));
      allow delete: if isAdmin();
    }

    match /admins/{uid} {
      allow read: if isSelf(uid) || isAdmin();
      allow write: if false;
    }

    match /bandApplications/{applicationId} {
      allow read: if isAdmin() || (signedIn() && resource.data.ownerUid == request.auth.uid);
      allow create: if signedIn()
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.keys().hasOnly(['ownerUid','ownerEmail','bandName','slug','genre','origin','description','contactEmail','instagramUrl','status','reviewNote','createdAt','updatedAt']);
      allow update: if isAdmin() || (owns(resource.data)
        && resource.data.status == 'needs_changes'
        && request.resource.data.ownerUid == resource.data.ownerUid
        && request.resource.data.status == 'pending'
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['bandName','slug','genre','origin','description','contactEmail','instagramUrl','status','reviewNote','updatedAt']));
      allow delete: if isAdmin();
    }

    match /bands/{bandId} {
      allow read: if isAdmin() || resource.data.isPublished == true || owns(resource.data);
      allow create: if isAdmin();
      allow update: if isAdmin() || (owns(resource.data)
        && resource.data.verificationStatus == 'approved'
        && request.resource.data.ownerUid == resource.data.ownerUid
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['name','slug','genre','origin','description','instagramUrl','websiteUrl','spotifyUrl','youtubeUrl','logoUrl','coverImageUrl','members','updatedAt']));
      allow delete: if isAdmin();
    }

    match /songs/{songId} {
      allow read: if isAdmin() || resource.data.isPublished == true || owns(resource.data);
      allow create: if isAdmin() || (signedIn()
        && request.resource.data.ownerUid == request.auth.uid
        && ownsApprovedBand(request.resource.data.bandId)
        && request.resource.data.isPublished == false
        && request.resource.data.status in ['draft','pending']);
      allow update: if isAdmin() || (owns(resource.data)
        && resource.data.isPublished != true
        && request.resource.data.ownerUid == resource.data.ownerUid
        && request.resource.data.bandId == resource.data.bandId
        && ownsApprovedBand(resource.data.bandId)
        && request.resource.data.isPublished == false
        && request.resource.data.status in ['draft','pending']);
      allow delete: if isAdmin() || (owns(resource.data) && resource.data.isPublished != true);
    }

    match /albums/{albumId} {
      allow read: if isAdmin() || resource.data.isPublished == true || owns(resource.data);
      allow create: if isAdmin() || (signedIn()
        && request.resource.data.ownerUid == request.auth.uid
        && ownsApprovedBand(request.resource.data.bandId)
        && request.resource.data.isPublished == false
        && request.resource.data.status == 'draft');
      allow update: if isAdmin() || (owns(resource.data)
        && resource.data.isPublished != true
        && request.resource.data.ownerUid == resource.data.ownerUid
        && request.resource.data.bandId == resource.data.bandId
        && ownsApprovedBand(resource.data.bandId)
        && request.resource.data.isPublished == false);
      allow delete: if isAdmin() || (owns(resource.data) && resource.data.isPublished != true);
    }

    match /announcements/{announcementId} {
      allow read: if isAdmin() || resource.data.isPublished == true;
      allow create, update, delete: if isAdmin();
    }

    match /adminAuditLogs/{logId} {
      allow read: if isAdmin();
      allow create: if isAdmin() && request.resource.data.actorUid == request.auth.uid;
      allow update, delete: if false;
    }

    match /{document=**} { allow read, write: if false; }
  }
}
